# ---------------------------
# LLM API Keys (Choose One or More)
# ---------------------------

# Option 1: OpenAI (Recommended - Best Balance of Cost/Quality)
# Get your key at: https://platform.openai.com/api-keys
# Cost: $0.15/1M input + $0.60/1M output tokens (gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Google Gemini (Free Tier Available)
# Get your key at: https://aistudio.google.com/app/apikey
# Cost: FREE up to 15 req/min, 1M tokens/day
GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: Anthropic Claude (Premium Option)
# Get your key at: https://console.anthropic.com/
# Cost: $0.25/1M input + $1.25/1M output tokens (claude-3-5-haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------
# Legacy Local Model (Optional - Can Remove)
# ---------------------------
LOCAL_LLM_PATH=models/phi-2.Q6_K.gguf

# ---------------------------
# Application Settings
# ---------------------------
ENVIRONMENT=development
DEBUG=true